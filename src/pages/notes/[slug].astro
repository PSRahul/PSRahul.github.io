---
import { type CollectionEntry, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import Tag from "@/components/Tag.astro";
import Comments from "@/components/Comments.astro";
import ShareLinks from "../writing/[...slug]/_components/ShareLinks.astro";
import { getSortedNotes } from "@/utils/getNotesAndPapers";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const notes = await getSortedNotes();
  return notes.map(note => ({ params: { slug: note.id }, props: { note } }));
}

type Props = { note: CollectionEntry<"notes"> };

const { note } = Astro.props;
const { title, description, pubDatetime, tags } = note.data;
const { Content } = await render(note);
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description ?? title}
  pubDatetime={pubDatetime}
>
  <Header />

  <Breadcrumb title={title} />

  <main id="main-content" class="app-layout" data-pagefind-body>
    <h1 class="text-accent mt-4 inline-block text-2xl font-bold sm:text-3xl">
      {title}
    </h1>
    <Datetime {pubDatetime} class="my-2" />

    <article
      id="article"
      class:list={[
        "mt-6 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <ul class="my-8 flex flex-wrap gap-4">
      {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>

    <ShareLinks />

    {config.giscus && <Comments />}
  </main>

  <Footer />
</PostLayout>
