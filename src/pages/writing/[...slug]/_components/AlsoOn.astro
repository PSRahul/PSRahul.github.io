---
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";

type Props = {
  syndication: CollectionEntry<"posts">["data"]["syndication"];
};

const { syndication } = Astro.props;
const t = useTranslations(Astro.currentLocale);

const links = [
  { label: "Substack", url: syndication?.substack },
  { label: "Medium", url: syndication?.medium },
].filter((link): link is { label: string; url: string } => Boolean(link.url));
---

{
  links.length > 0 && (
    <p class="text-muted-foreground mt-8 text-sm">
      {t.post.alsoOn}{" "}
      {links.map((link, index) => (
        <>
          {index > 0 && " · "}
          <a
            href={link.url}
            target="_blank"
            rel="noopener"
            class="hover:text-accent underline decoration-dashed underline-offset-4"
          >
            {link.label}
          </a>
        </>
      ))}
    </p>
  )
}
