---
import type { GetStaticPaths } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import WritingCard from "@/components/WritingCard.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getWritingItems } from "@/utils/getWritingItems";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const items = await getWritingItems();
  return paginate(items, { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.postsDesc}>
    <p class="text-muted-foreground -mt-4 mb-2 text-sm">
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class="hover:text-accent underline decoration-dashed underline-offset-4"
        >{t.nav.tags}</a
      >
      ·
      <a
        href={getRelativeLocaleUrl(locale, "series")}
        class="hover:text-accent underline decoration-dashed underline-offset-4"
        >{t.series.label}</a
      >
      ·
      <a
        href="/rss.xml"
        class="hover:text-accent underline decoration-dashed underline-offset-4"
        >{t.footer.rss}</a
      >
    </p>
    <ul>
      {page.data.map(item => <WritingCard item={item} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
