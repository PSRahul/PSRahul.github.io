---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import bioPhoto from "@/assets/images/bio-photo.jpg";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import WritingCard from "@/components/WritingCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getWritingItems } from "@/utils/getWritingItems";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig, syndication } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const writing = (await getWritingItems(locale)).slice(0, postsConfig.perIndex);
const featuredProjects = (
  await getCollection("projects", ({ data }) => data.featured)
).sort((a, b) => a.data.order - b.data.order);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <div class="my-4 flex items-center gap-5 sm:my-8">
        <Image
          src={bioPhoto}
          alt="Portrait of Rahul Parthasarathy Srikanth"
          width={96}
          height={96}
          densities={[1, 2]}
          loading="eager"
          class="border-border size-20 shrink-0 rounded-full border object-cover sm:size-24"
        />
        <div>
          <h1 class="inline-block text-4xl font-bold sm:text-5xl">
            Hi, I'm Rahul
          </h1>
          <a
            target="_blank"
            href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
            class="ms-2 inline-block"
            aria-label="RSS Feed"
            title="RSS Feed"
          >
            <IconRss
              width={20}
              height={20}
              class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
            />
            <span class="sr-only">RSS Feed</span>
          </a>
        </div>
      </div>

      <p>
        I'm a machine learning engineer. I build production ML systems end to
        end, from data pipelines and training to evaluation and inference. My
        work has spanned computer vision, few-shot detection and, more recently,
        LLMs and generative models.
      </p>
      <p class="mt-2">
        Here I write about what I learn and keep a record of
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "projects")}
        >
          projects
        </LinkButton>. More
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          about me
        </LinkButton>.
      </p>
      <p class="mt-2">
        Co-author of
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={`${getRelativeLocaleUrl(locale, "about")}#publications`}
        >
          PhoCaL (CVPR 2022)
        </LinkButton>, a multi-modal dataset for category-level object pose
        estimation.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      writing.length > 0 && (
        <section id="recent-posts" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {writing.map(item => (
              <WritingCard variant="h3" item={item} />
            ))}
          </ul>
          <div class="my-4">
            <LinkButton href={getRelativeLocaleUrl(locale, "writing")}>
              {t.home.allPosts}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      featuredProjects.length > 0 && (
        <section id="projects" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.selectedProjects}
          </h2>
          <ul>
            {featuredProjects.map(project => (
              <ProjectCard project={project} />
            ))}
          </ul>
          <div class="my-4">
            <LinkButton href={getRelativeLocaleUrl(locale, "projects")}>
              {t.home.allProjects}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }

    {
      syndication.substack && (
        <section
          id="subscribe"
          class="border-border my-8 rounded-md border border-dashed p-6"
        >
          <h2 class="text-xl font-semibold">{t.home.subscribe}</h2>
          <p class="mt-2">{t.home.subscribeDesc}</p>
          <a
            href={`https://${syndication.substack}.substack.com/subscribe`}
            target="_blank"
            rel="noopener"
            class="bg-accent text-background mt-4 inline-block rounded px-4 py-2 font-medium hover:opacity-90"
          >
            Subscribe on Substack
          </a>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
