---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();

const locale = Astro.currentLocale ?? config.site.lang;
const footerLinks = [
  {
    href: getRelativeLocaleUrl(locale, "start-here"),
    label: t.footer.startHere,
  },
  { href: getRelativeLocaleUrl(locale, "now"), label: t.footer.now },
  { href: getRelativeLocaleUrl(locale, "uses"), label: t.footer.uses },
  { href: getRelativeLocaleUrl(locale, "colophon"), label: t.footer.colophon },
  { href: "/rss.xml", label: t.footer.rss },
];
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <nav
    aria-label="Site"
    class="border-border text-muted-foreground flex flex-wrap justify-center gap-x-4 gap-y-1 border-t pt-6 text-sm sm:justify-start sm:pt-4"
  >
    {
      footerLinks.map(({ href, label }) => (
        <a
          {href}
          class="hover:text-accent underline decoration-dashed underline-offset-4"
        >
          {label}
        </a>
      ))
    }
  </nav>
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t.footer.allRightsReserved}</span>
    </div>
  </div>
</footer>
