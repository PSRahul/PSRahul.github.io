---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

/**
 * Image with a caption, for .mdx posts.
 *
 *   import Figure from "@/components/mdx/Figure.astro";
 *   import attention from "./attention.png";
 *   <Figure src={attention} alt="…" caption="Attention weights per head." />
 *
 * `src` may also be a path under public/, e.g. "/assets/images/x.webp".
 */
type Props = {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  /** Display width in px; the image never exceeds the text column */
  width?: number;
};

const { src, alt, caption, width } = Astro.props;
---

<figure class="mx-auto" style={width ? { maxWidth: `${width}px` } : undefined}>
  {
    typeof src === "string" ? (
      <img {src} {alt} loading="lazy" decoding="async" class="mx-auto" />
    ) : (
      <Image {src} {alt} width={width} class="mx-auto" />
    )
  }
  {caption && <figcaption class="text-center">{caption}</figcaption>}
</figure>
